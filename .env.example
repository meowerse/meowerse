# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Each line notes WHERE to get the value.

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Dashboard → My Profile → API Tokens → Create (all needed perms).
CLOUDFLARE_API_TOKEN=
# Dashboard sidebar (right side of any zone overview).
CLOUDFLARE_ACCOUNT_ID=
# Zone overview → API section (this repo's zone is alxnko.eu.org).
CLOUDFLARE_ZONE_ID=

# Terraform reads these as TF_VAR_* (export before `terraform plan`):
#   export TF_VAR_cloudflare_account_id=$CLOUDFLARE_ACCOUNT_ID
#   export TF_VAR_cloudflare_zone_id=$CLOUDFLARE_ZONE_ID

# ── Turso (libSQL) ────────────────────────────────────────────────────────────
# `turso auth token`  OR  app.turso.tech → Account → API Tokens.
TURSO_API_TOKEN=
# Produced by infra/turso/bootstrap.sh (or `terraform output`). Used by the Go api.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Cloudflare Worker (bot0) ──────────────────────────────────────────────────
# Telegram webhook path secret. Production: `wrangler secret put PATH_SECRET`.
# Local dev: workers/edge/.dev.vars (also gitignored).
PATH_SECRET=

# ── Northflank (Go api host) ──────────────────────────────────────────────────
# Northflank → Account → API tokens. Used by the deploy workflow to push secrets.
NORTHFLANK_API_TOKEN=

# ── R2 (object storage) — only once you enable R2 (needs a payment method) ─────
# Cloudflare → R2 → Manage R2 API Tokens. Also used as Terraform's S3 state backend later.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
