{
  "$schema": "node_modules/wrangler/config-schema.json",
  // meowerse AUTH Worker — the OIDC identity provider ("Auth with Meowerse").
  // Mirrors workers/api: thin DI router, Turso via @libsql/client/web, custom
  // domain, secrets out of source.
  //
  // SECRETS (never in this file): set with wrangler before first deploy —
  //   bunx wrangler secret put DATABASE_URL
  //   bunx wrangler secret put DATABASE_AUTH_TOKEN
  //   bunx wrangler secret put AUTH_SIGNING_KEYS   (JSON array of ES256 JWKs)
  "name": "meowerse-auth",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  // @libsql/client/web pulls node builtins; nodejs_compat resolves them in workerd.
  "compatibility_flags": ["nodejs_compat"],
  // ONE Worker on auth.alxnko.eu.org serves the Astro UI (static assets) AND all
  // OIDC/API routes. Cloudflare serves a matching static asset BEFORE invoking the
  // worker: GET page paths (/account, /developers, /verify, …) render as HTML for
  // free; non-asset paths (/authorize, /token, /api/*, /tg/*, …) hit the fetch handler,
  // which falls back to env.ASSETS.fetch(req) for the Astro 404.
  //
  // COLLISION: /signup, /login, /consent are BOTH a page (GET renders the form) AND an
  // API endpoint (POST submits it). CF answers a POST to an asset path with 405 WITHOUT
  // running the worker, so the worker's POST handler is unreachable for these three —
  // run_worker_first makes the worker run FIRST for exactly these paths (POST → handler;
  // GET → no match → env.ASSETS.fetch serves the page). Every other page stays free.
  "assets": {
    "directory": "../../apps/auth-web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/signup", "/login", "/consent"]
    // NOTE: do NOT set "not_found_handling": "404-page" here. With a run_worker_first
    // LIST, every path outside that list is treated asset-first, so 404-page would
    // serve 404.html BEFORE the worker runs — shadowing /authorize, /token, /jwks,
    // /api/*, … (breaks the whole IdP). The worker fallback serves the styled
    // 404.html itself (see index.ts) so unknown paths still get a real 404 page.
  },
  // Smart Placement: this worker is DB-bound (every request round-trips to the
  // Turso primary in aws-eu-west-1). Let Cloudflare run the isolate NEAR Turso
  // instead of at the user's edge, so N sequential db hops pay one long RTT to
  // reach Ireland once, then short intra-region hops — not N long RTTs.
  "placement": { "mode": "smart" },
  "vars": {
    "CORS_ORIGINS": "https://auth.alxnko.dev,https://auth.alxnko.eu.org,http://localhost:4321",
    // Issuer = this same host: discovery, /jwks, /authorize, /token, /userinfo AND
    // the UI (login/consent/account …) are all same-origin on ONE worker. WEB_ORIGIN
    // is the user-facing UI the authorize flow redirects into — now the same host.
    "ISSUER": "https://auth.alxnko.dev",
    "WEB_ORIGIN": "https://auth.alxnko.dev",
    "RESOURCE_AUD": "https://api.meow.alxnko.dev",
    "BOT_USERNAME": "meowersebot",
    "SKIP_MIGRATIONS": "1"
  },
  // Custom domain — Cloudflare provisions cert + DNS.
  "routes": [
    { "pattern": "auth.alxnko.dev", "custom_domain": true },
    { "pattern": "auth.alxnko.eu.org", "custom_domain": true }
  ]
}
