{
  "name": "@meowerse/auth-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "bun run --filter @meowerse/auth-web build && wrangler deploy --dry-run --outdir tmp/wr-auth",
    "test": "vitest run --coverage",
    "secret:db-url": "wrangler secret put DATABASE_URL",
    "secret:db-token": "wrangler secret put DATABASE_AUTH_TOKEN",
    "secret:signing-keys": "wrangler secret put AUTH_SIGNING_KEYS"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@meowerse/auth-shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
