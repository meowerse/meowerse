{
  "$schema": "node_modules/wrangler/config-schema.json",
  // meowsenger — ONE Worker on meowsenger.alxnko.eu.org that serves the Astro UI
  // (static assets) AND the OIDC BFF (/auth/*, /api/*). Durable Objects + /ws
  // land in Slice 2 on this same worker/host, so the session cookie works for the
  // WebSocket too (same origin). Cloudflare serves matching static assets BEFORE
  // invoking the worker (they don't consume worker quota); non-asset paths
  // (/auth/*, /api/*, 404s) run the fetch handler.
  //
  // SECRETS (never in this file): bunx wrangler secret put OIDC_CLIENT_SECRET
  // D1: created via `wrangler d1 create meowsenger`.
  // NO smart placement: fronts D1 (read-replicated) + (Slice 2) DOs (near first access).
  "name": "meowsenger",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  // not_found_handling: serve the built 404.html (404 status) for any path matching
  // no asset, so env.ASSETS.fetch(req) on an unknown route renders the styled Astro
  // 404 instead of a bare, browser-default "page can't be found".
  "assets": { "directory": "../../apps/meowsenger-web/dist", "binding": "ASSETS", "not_found_handling": "404-page" },
  "vars": {
    "OIDC_ISSUER": "https://auth.alxnko.eu.org",
    "OIDC_CLIENT_ID": "mw_3r2h7kHnfV_tOLGTTND4Yw",
    "OIDC_REDIRECT_URI": "https://meowsenger.alxnko.eu.org/auth/callback",
    "WEB_ORIGIN": "https://meowsenger.alxnko.eu.org",
    "CORS_ORIGINS": "https://meowsenger.alxnko.eu.org,http://localhost:4321,http://127.0.0.1:8787",
    // Web Push (VAPID). The PUBLIC key + subject are public; the PRIVATE key is a
    // secret set once via `wrangler secret put VAPID_PRIVATE_JWK`.
    "VAPID_PUBLIC_KEY": "BKUWUCdMbpAxBrJdzMMiCvHIokH8F8e-DA3bgIwz9tmFlxMDWQOx9LXhHnhXTc6F7mVviScV9Kcvc5SOzqAg4vo",
    "VAPID_SUBJECT": "mailto:aleksandrnyrko@gmail.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "meowsenger", "database_id": "d287edf4-c3c8-4328-9c47-14094f08ca42" }
  ],
  // Slice 2: one Conversation Durable Object per chat — holds the room's live
  // WebSockets (Hibernation API) + an embedded SQLite message log. The class is
  // exported from src/index.ts (Task 3); new_sqlite_classes registers its
  // SQLite storage backend on first deploy.
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATION", "class_name": "Conversation" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation"] }],
  "routes": [{ "pattern": "meowsenger.alxnko.eu.org", "custom_domain": true }]
}
