{
  "name": "@meowerse/meowsenger-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "bun run --filter @meowerse/meowsenger-web build && wrangler deploy --dry-run --outdir /tmp/wr-meowsenger",
    "test": "vitest run --coverage --config vitest.config.ts && vitest run --config vitest.workers.config.ts --passWithNoTests",
    "test:node": "vitest run --config vitest.config.ts",
    "test:do": "vitest run --config vitest.workers.config.ts --passWithNoTests",
    "provision": "bun scripts/provision.ts",
    "secret:client-secret": "wrangler secret put OIDC_CLIENT_SECRET",
    "d1:schema": "wrangler d1 execute meowsenger --remote --file schema.sql",
    "d1:schema-local": "wrangler d1 execute meowsenger --local --file schema.sql",
    "d1:schema-slice5": "wrangler d1 execute meowsenger --remote --file schema-slice5.sql",
    "d1:schema-slice7": "wrangler d1 execute meowsenger --remote --file schema-slice7.sql",
    "d1:schema-sec1": "wrangler d1 execute meowsenger --remote --file schema-sec1.sql"
  },
  "dependencies": {
    "@meowerse/auth": "workspace:*",
    "@meowerse/auth-shared": "workspace:*",
    "@meowerse/ts-shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "vitest": "^5.1.1",
    "wrangler": "4.116.0"
  }
}
