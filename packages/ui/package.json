{
  "name": "@meowerse/ui",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./tokens.json": "./design/tokens.json",
    "./theme": "./src/lib/theme.ts",
    "./status": "./src/lib/status.ts",
    "./seo": "./src/lib/seo.ts",
    "./assets/fonts/*": "./src/assets/fonts/*",
    "./cat3d": "./src/cat3d/index.ts",
    "./cat3d/attach": "./src/cat3d/attach.ts"
  },
  "files": ["src", "design"],
  "scripts": {
    "lint": "bun run tokens:check && tsc --noEmit",
    "test": "vitest run --coverage",
    "tokens": "bun scripts/gen-tokens.ts",
    "tokens:check": "bun scripts/gen-tokens.ts --check",
    "tokens:drift": "bun scripts/tokens-drift.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@tabler/icons": "^3.52.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "bun-types": "^1.4.5",
    "jsdom": "^31.0.1",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.1.1"
  }
}
