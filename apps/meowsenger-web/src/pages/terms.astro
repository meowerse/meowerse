---
import Layout from "../layouts/Layout.astro";
import { Card } from "@meowerse/ui";
---
<Layout title="terms · meowsenger">
  <div class="mw-prose">
    <h1>terms of use</h1>
    <p>Meowsenger shares one set of terms with every meowverse service, with a short section for Meowsenger: <a href="https://auth.alxnko.dev/terms"><strong>read the full terms</strong></a>.</p>

    <Card title="meowsenger in short">
      <ul>
        <li>A free, best-effort chat service, provided as-is with no warranty.</li>
        <li>Not end-to-end encrypted: the server can read and process messages to deliver them, keep history, search and show previews.</li>
        <li>No spam, harassment, illegal content or abuse. Content that breaks the terms may be removed.</li>
      </ul>
    </Card>

    <p class="mw-muted">See also the <a href="https://auth.alxnko.dev/privacy">shared privacy policy</a>.</p>
  </div>
</Layout>
