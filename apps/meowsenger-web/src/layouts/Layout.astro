---
import "@meowerse/ui/tokens.css";
import "../styles/app.css";
import { THEME_INIT_SCRIPT, Footer } from "@meowerse/ui";
import MeowsengerHeader from "../components/MeowsengerHeader.tsx";
// `footer` defaults on for content pages; the full-height chat shell (/app) and
// the centered join preview (/join) pass footer={false}.
interface Props { title: string; bodyClass?: string; footer?: boolean; header?: boolean }
const { title, bodyClass, footer = true, header = true } = Astro.props;
const footerLinks = [
  { label: "about", href: "/about" },
  { label: "privacy", href: "/privacy" },
  { label: "terms", href: "/terms" },
];
// Same-origin: the UI + BFF are one Worker on meowsenger, so API
// calls use relative paths (base = "" → "/auth/login", "/api/session").
const base = import.meta.env.PUBLIC_MEOWSENGER_API_URL ?? "";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    <script is:inline set:html={THEME_INIT_SCRIPT}></script>
  </head>
  <body class={bodyClass}>
    {header && <MeowsengerHeader client:idle base={base} />}
    <main class="mw-container">
      <slot />
    </main>
    {footer && <Footer links={footerLinks} legal="meowsenger — a personal project by alxnko" />}
  </body>
</html>
