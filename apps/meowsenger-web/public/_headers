# Cloudflare headers for the meowsenger UI. Cloudflare COMBINES same-name headers
# across matching rules and does NOT let a specific path override /* — so there is
# no blanket Cache-Control under /*; each path sets exactly one (see auth-web).
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://auth.alxnko.dev https://auth.alxnko.eu.org https://t.me https://*.telegram.org data:; connect-src 'self' wss://meowsenger.alxnko.dev wss://meowsenger.alxnko.eu.org https://auth.alxnko.dev https://auth.alxnko.eu.org

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# Static content pages — same cache policy as the landing page.
/about*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
/privacy*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
/terms*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# The app shell is session-bearing — never cache.
# Split rather than /app*: that also matched /apple-touch-icon.png, and since
# Cloudflare MERGES same-name headers across rules, the icon was being served
# "no-store, public, max-age=604800".
/app
  Cache-Control: no-store
  X-Robots-Tag: noindex
/app/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Private pages kept out of search (X-Robots-Tag, alongside the <meta name="robots"> the layout
# writes from src/lib/seo.ts). /join previews nothing without a session. One X-Robots-Tag rule per
# path; same /app-style prefix care: nothing else starts with /join or /404.
/join*
  X-Robots-Tag: noindex
/404*
  X-Robots-Tag: noindex

# Crawler files (static assets, never the Worker): an hour, one Cache-Control each.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Brand icons (packages/brand). Stable URLs but NOT content-hashed, so they get a
# week of caching rather than the immutable year used for /_astro/*. One
# Cache-Control per path, per the caveat above.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800
