---
const base = import.meta.env.PUBLIC_API_URL ?? "https://api.meow.alxnko.dev";
const token = import.meta.env.PUBLIC_DEMO_TOKEN ?? "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>meowerse</title>
    <!-- Icons: generated by packages/brand (bash packages/brand/scripts/build.sh).
         sizes="32x32" on the .ico is what makes browsers that understand SVG skip it. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <h1>meowerse</h1>
    <div id="meow-app" data-base={base} data-token={token}>
      <input id="meow-text" placeholder="meow..." />
      <button id="meow-add">add</button>
      <ul id="meow-list"></ul>
    </div>
    <script>
      // Dynamically import the island logic: keeps the inline bootstrap tiny and
      // ships the DOM logic as a hashed, immutably-cached /_astro chunk (no react).
      void import("../scripts/meow-island");
    </script>
  </body>
</html>
