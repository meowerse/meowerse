---
// Cloudflare Pages auto-serves this built /404.html (with a 404 status) for any
// path that matches no static asset — self-contained (this app has no shared layout).
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · meowerse</title>
    <!-- Icons: generated by packages/brand (bash packages/brand/scripts/build.sh).
         sizes="32x32" on the .ico is what makes browsers that understand SVG skip it. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; margin: 0; }
      body {
        min-height: 100dvh; display: grid; place-items: center;
        background: #0b0b0b; color: #eaeaea;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        text-transform: lowercase; padding: 24px;
      }
      .wrap { text-align: center; display: grid; gap: 12px; }
      .code { font-size: clamp(64px, 18vw, 128px); font-weight: 800; color: #00ff82; line-height: 1; letter-spacing: -0.03em; }
      .msg { color: #9a9a9a; font-size: 16px; }
      a { color: #00ff82; text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.15s; }
      a:hover { border-color: #00ff82; }
    </style>
  </head>
  <body>
    <main class="wrap">
      <p class="code">404</p>
      <p class="msg">that page wandered off.</p>
      <p><a href="/">back home</a></p>
    </main>
  </body>
</html>
