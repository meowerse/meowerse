# Cloudflare Pages headers for the web app.
#
# Cache-Control caveat: Cloudflare COMBINES same-name headers across EVERY
# matching rule — a more-specific path does NOT override a blanket one. So there
# is deliberately NO Cache-Control under /*: a blanket rule there would merge
# into this immutable one (e.g. "no-store, …, immutable") and defeat caching.
# Set exactly ONE Cache-Control per path.

/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Content-hashed build assets (/_astro/*) never change under a given URL — cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Brand icons (packages/brand). Stable URLs but NOT content-hashed, so they get a
# week of caching rather than the immutable year used for /_astro/*. One
# Cache-Control per path, per the caveat above.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800
