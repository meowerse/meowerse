# Cloudflare headers for the auth UI (spec §7, §10/#8).
# script-src needs 'unsafe-inline': Astro inlines its island-hydration bootstrap +
# our no-flash theme script, so a strict script-src 'self' blocks all JS and
# nothing hydrates (every spinner freezes). challenges.cloudflare.com is Turnstile.
#
# Cache-Control caveat (learned in prod): Cloudflare COMBINES same-name headers
# across EVERY matching rule — it does NOT let a more-specific path override. So
# there is deliberately NO Cache-Control under /*: a blanket `no-store` there
# merged into every page AND asset ("no-store, …, immutable") and silently
# defeated all caching. Instead each path sets exactly ONE Cache-Control —
# static content + hashed assets cache; session-bearing pages are explicitly
# no-store. Splats (/about*) cover the trailing-slash canonical URLs Astro emits
# (/about/, /docs/, …). NOTE: a new authed page must be added to the no-store
# list below — there is no blanket default anymore.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com

# Content-hashed build assets never change under a given URL — cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static content pages: browser revalidates, the edge serves instantly and
# refreshes in the background.
/
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
/about*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
/docs*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
/privacy*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
/terms*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# Session-bearing / dynamic pages: never cache (explicit — no blanket default now).
# They are also kept out of search (X-Robots-Tag, alongside the <meta name="robots"> the layout
# writes from src/lib/seo.ts): the landing page is the search entry, these flows are reached from it
# or from an app. One X-Robots-Tag rule per path, same merging caveat as Cache-Control.
/account*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/dashboard*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/consent*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/verify*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/login*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/signup*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/developers*
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Private pages with no Cache-Control of their own (default caching is fine for them).
/error*
  X-Robots-Tag: noindex
/404*
  X-Robots-Tag: noindex

# Crawler files (static assets, never the Worker): an hour, one Cache-Control each.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Brand icons (packages/brand). Stable URLs but NOT content-hashed, so they get a
# week of caching rather than the immutable year used for /_astro/*. One
# Cache-Control per path, per the caveat above.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800
