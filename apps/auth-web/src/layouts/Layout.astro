---
interface Props {
  title: string;
}
const { title } = Astro.props;
// Defense-in-depth: the same no-referrer/no-store posture the worker sets, also
// applied at the page response (the Pages _headers file covers static assets).
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "no-store");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light dark;
        --accent: #6c5ce7;
        --border: rgba(127, 127, 127, 0.25);
        --ok: #1e8e5a;
      }
      * { box-sizing: border-box; }
      body { font-family: system-ui, -apple-system, sans-serif; margin: 0; line-height: 1.55; }
      header.site {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); gap: 1rem;
      }
      header.site .brand { font-weight: 700; text-decoration: none; color: inherit; }
      header.site nav a { margin-left: 1rem; text-decoration: none; opacity: 0.8; font-size: 0.95rem; }
      main { max-width: 34rem; margin: 2.5rem auto; padding: 0 1rem; }
      h1 { font-size: 1.5rem; }
      h2 { font-size: 1.1rem; margin-top: 2rem; }
      section { border-top: 1px solid var(--border); padding-top: 0.5rem; }
      .auth-form label, label.block { display: block; margin: 0.75rem 0; }
      .auth-form input[type="text"], .auth-form input[type="password"], .auth-form input:not([type]) {
        display: block; width: 100%; padding: 0.55rem; margin-top: 0.25rem;
        border: 1px solid var(--border); border-radius: 6px; background: transparent; color: inherit;
      }
      fieldset { border: 1px solid var(--border); border-radius: 8px; margin: 0.75rem 0; padding: 0.5rem 0.75rem; }
      legend { padding: 0 0.4rem; opacity: 0.8; font-size: 0.9rem; }
      label.inline { display: block; margin: 0.3rem 0; font-weight: normal; }
      button {
        padding: 0.55rem 1.1rem; cursor: pointer; border: 1px solid var(--accent);
        background: var(--accent); color: #fff; border-radius: 6px; font: inherit;
      }
      button.secondary { background: transparent; color: inherit; border-color: var(--border); }
      button:disabled { opacity: 0.5; cursor: progress; }
      .error { color: #c0392b; }
      .ok-msg { color: var(--ok); }
      .actions { display: flex; gap: 0.75rem; margin-top: 1rem; }
      .muted { opacity: 0.7; font-size: 0.9rem; }
      .badge { font-size: 0.8rem; padding: 0.1rem 0.5rem; border: 1px solid var(--border); border-radius: 999px; }
      .badge.ok { color: var(--ok); border-color: var(--ok); }
      ul.scopes { list-style: none; padding: 0; }
      code { background: rgba(127, 127, 127, 0.15); padding: 0.1rem 0.3rem; border-radius: 3px; word-break: break-all; }
      pre { background: rgba(127, 127, 127, 0.12); padding: 0.75rem; border-radius: 8px; overflow-x: auto; font-size: 0.85rem; }
      .recovery { border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem 1rem; margin: 1rem 0; }
      a { color: var(--accent); }
    </style>
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/">🐾 Meowerse Accounts</a>
      <nav>
        <a href="/account">Account</a>
        <a href="/dashboard">Developers</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
