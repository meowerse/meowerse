---
import Layout from "../layouts/Layout.astro";
import LandingCta from "../components/LandingCta.tsx";
const base = import.meta.env.PUBLIC_AUTH_API_URL ?? ""; // same-origin: relative fetches
---
<Layout title="meowerse accounts">
  <div class="mw-stack">
    <h1>meowerse accounts</h1>
    <LandingCta client:load base={base} />
    <p class="mw-muted"><a href="/developers">building an app?</a></p>
  </div>
  <script is:inline>
    fetch("/api/session", { credentials: "include" })
      .then(function(r) { return r.json(); })
      .then(function(s) {
        if (s && s.authenticated) {
          window.location.replace("/account");
        }
      })
      .catch(function() {});
  </script>
</Layout>
