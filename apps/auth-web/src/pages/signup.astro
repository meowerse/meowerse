---
import Layout from "../layouts/Layout.astro";
import SignupForm from "../components/SignupForm.tsx";
import TelegramButton from "../components/TelegramButton.tsx";
const base = import.meta.env.PUBLIC_AUTH_API_URL ?? "https://auth-api.alxnko.eu.org";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title="Create account · Meowerse">
  <h1>Create a Meowerse account</h1>
  <SignupForm client:load base={base} turnstileSiteKey={turnstileSiteKey} />
  <p class="muted">— or —</p>
  <TelegramButton client:load base={base} />
  <p class="muted">Already have one? <a href="/login">Sign in</a>.</p>
</Layout>
