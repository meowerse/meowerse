---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Verification required · Meowerse">
  <h1>Verification required</h1>
  <p>This app only accepts verified accounts. Verification links your Telegram to
    your Meowerse account.</p>
  <p class="muted">Telegram verification arrives in the next release. For now, this
    app is unavailable to unverified accounts.</p>
  <p><a href="/login"><button class="secondary">Back to sign in</button></a></p>
</Layout>
