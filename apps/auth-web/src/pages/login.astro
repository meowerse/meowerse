---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm.tsx";
import TelegramButton from "../components/TelegramButton.tsx";
const base = import.meta.env.PUBLIC_AUTH_API_URL ?? "https://auth-api.alxnko.eu.org";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title="Sign in · Meowerse">
  <div class="mw-stack mw-narrow">
    <h1>Sign in with Meowerse</h1>
    <LoginForm client:load base={base} turnstileSiteKey={turnstileSiteKey} />
    <p class="mw-muted" style="text-align:center">— or —</p>
    <TelegramButton client:load base={base} />
    <p class="mw-muted">No account? <a href="/signup">Create one</a>.</p>
  </div>
</Layout>
