{
  "name": "meowerse",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "bun": ">=1.4.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:selftest": "bun test scripts/typecheck-selftest.test.ts",
    "perf:meowsenger": "bun run --filter @meowerse/meowsenger-web perf:baseline"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.5"
}
